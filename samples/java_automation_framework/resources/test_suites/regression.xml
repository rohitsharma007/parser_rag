<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  TestNG Regression Suite
  Includes all 6 test classes covering the full ATR portal automation flows:
    - Flow 1: Login + Navigation   (ATR_Portal_Tests)
    - Flow 2: Account Creation     (ATR_Application_Regression_Tests)
    - Flow 3: Menu Navigation      (ATR_Web_Portal_Tests)
    - Flow 4: Retry Scenario       (ATR_Portal_POC_Retry_Tests)
    - Flow 5: Cloud Validation     (Azure_Public_Cloud_Tests)
    - POC Tests                    (ATR_Portal_POC_Tests)
-->
<suite name="ATR Automation Regression Suite" verbose="1" parallel="tests" thread-count="3">

    <!-- Suite-level parameters -->
    <parameter name="browser"   value="chrome"/>
    <parameter name="env"       value="staging"/>
    <parameter name="headless"  value="false"/>

    <!-- ──────────────────────────────────────────────────────────────────── -->
    <!-- Flow 1: Login + Navigation                                           -->
    <!-- ──────────────────────────────────────────────────────────────────── -->
    <test name="ATR Portal Login and Navigation Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.ntrs.demoapp.testcases.web.ATR_Portal_Tests"/>
        </classes>
    </test>

    <!-- ──────────────────────────────────────────────────────────────────── -->
    <!-- Flow 2: Account Creation (API + UI)                                  -->
    <!-- ──────────────────────────────────────────────────────────────────── -->
    <test name="ATR Application Regression Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.ntrs.demoapp.testcases.web.ATR_Application_Regression_Tests"/>
        </classes>
    </test>

    <!-- ──────────────────────────────────────────────────────────────────── -->
    <!-- Flow 3: Menu Navigation                                              -->
    <!-- ──────────────────────────────────────────────────────────────────── -->
    <test name="ATR Web Portal Navigation Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.ntrs.demoapp.testcases.web.ATR_Web_Portal_Tests"/>
        </classes>
    </test>

    <!-- ──────────────────────────────────────────────────────────────────── -->
    <!-- POC Tests                                                            -->
    <!-- ──────────────────────────────────────────────────────────────────── -->
    <test name="ATR Portal POC Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.ntrs.demoapp.testcases.web.ATR_Portal_POC_Tests"/>
        </classes>
    </test>

    <!-- ──────────────────────────────────────────────────────────────────── -->
    <!-- Flow 4: Retry Scenario                                               -->
    <!-- ──────────────────────────────────────────────────────────────────── -->
    <test name="ATR Portal POC Retry Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.ntrs.demoapp.testcases.web.ATR_Portal_POC_Retry_Tests"/>
        </classes>
    </test>

    <!-- ──────────────────────────────────────────────────────────────────── -->
    <!-- Flow 5: Cloud Validation                                             -->
    <!-- ──────────────────────────────────────────────────────────────────── -->
    <test name="Azure Public Cloud Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.ntrs.demoapp.testcases.web.Azure_Public_Cloud_Tests"/>
        </classes>
    </test>

    <!-- Suite-level listeners -->
    <listeners>
        <listener class-name="org.testng.reporters.SuiteHTMLReporter"/>
    </listeners>

</suite>
